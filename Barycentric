#this code is meant to be run in Rstudio

install.packages("Radviz")
library(Radviz)
library(ggtern)
# Load required libraries
library(ggplot2)

# Function to compute gene position within triangle based on inverted similarities
get_gene_position <- function(simAB, simAC, simBC) {
  # Invert similarity so low similarity = high weight; treats sim as distance
  invAB <- 1 / simAB
  invAC <- 1 / simAC
  invBC <- 1 / simBC
#normalize distances to get weights  
  total <- invAB + invAC + invBC #sum up inverse distances to get total
  wAB <- invAB / total #divide each inverse distance by normal distance to get weights
  wAC <- invAC / total
  wBC <- invBC / total
#ensures weight sums up to one, imp for weighted avg  
  # Define triangle vertices
  A <- c(0, 0)   # Human
  B <- c(1, 0)   # Capybara
  C <- c(0.5, sqrt(3)/2)  # Mouse
  
  # Edge midpoints
  pos_AB <- (A + B) / 2
  pos_AC <- (A + C) / 2
  pos_BC <- (B + C) / 2
  
  # Weighted average of edge midpoints
  #apply weights to midpoints 
  x <- wAB * pos_AB[1] + wAC * pos_AC[1] + wBC * pos_BC[1]
  y <- wAB * pos_AB[2] + wAC * pos_AC[2] + wBC * pos_BC[2]
  
  return(c(x, y))
}

# Similarity data
similarity_df <- data.frame(
  Gene = c("YAP1", "TAZ", "SAV1", "LATS1", "LATS2"),
  Human_Capybara = c(0.89, 4.29, 3.46, 4.87, 4.25), #lower sim = higher dist
  Human_Mouse = c(7.1, 6.6, 5.59, 6.5, 4.87),
  Mouse_Capybara = c(7.44, 7.92, 5.85, 8.21, 4.72)
)

# Compute positions
positions <- t(mapply(get_gene_position,
                      similarity_df$Human_Capybara,
                      similarity_df$Human_Mouse,
                      similarity_df$Mouse_Capybara))

plot_data <- data.frame(
  Gene = similarity_df$Gene,
  x = positions[, 1],
  y = positions[, 2]
)

# Triangle vertex labels
triangle_labels <- data.frame(
  x = c(0, 1, 0.5),
  y = c(0, 0, sqrt(3)/2),
  label = c("Human", "Capybara", "Mouse")
)

# Triangle outline points (closing the triangle)
triangle_outline <- data.frame(
  x = c(0, 1, 0.5, 0),
  y = c(0, 0, sqrt(3)/2, 0)
)

centroid <- data.frame(
  x = 0.5,
  y = sqrt(3)/6
)

p <- ggplot(plot_data, aes(x = x, y = y)) +
  geom_path(data = triangle_outline, aes(x = x, y = y), color = "black", size = 1) +
  geom_point(data = centroid, aes(x = x, y = y), shape = 4, size = 3, stroke = 1, color = "black") +  # Center marker
  geom_point(aes(color = Gene), size = 2) +
  geom_text(data = triangle_labels, aes(x = x, y = y, label = label),
            vjust = c(1.5, 1.5, -0.5), size = 4.5, fontface = "bold") +
  coord_fixed(clip = "off", xlim = c(-0.1, 1.1), ylim = c(-0.1, 1)) +
  theme_minimal(base_size = 14) +
  theme(
    plot.margin = unit(c(2, 2, 2, 2), "lines")
  )



# Display plot
print(p)

# Save to file
ggsave("barycentric_plot_clean.png", plot = p, width = 6, height = 6, dpi = 300)
